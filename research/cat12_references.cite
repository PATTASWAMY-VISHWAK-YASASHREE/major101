  abstract = {Grad-CAM generates class-discriminative visual explanations using the gradients flowing into the final convolutional layer of any convolutional neural network.}
}

@article{lundberg2017shap,
  author = {Lundberg, Scott M and Lee, Su-In},
  title = {A Unified Approach to Interpreting Model Predictions},

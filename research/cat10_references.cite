Cite file for Category 10: Self-Supervised / Semi-Supervised / Few-Shot Learning
================================================================================
Brain Tumour Classification Research
Note: prior fabricated entries were removed; this file contains only verifiable public references.

@article{he2022mae,
  author = {He, Kaiming and Chen, Xinlei and Xie, Saining and Li, Yanghao and Dollár, Piotr and Girshick, Ross},
  title = {Masked Autoencoders Are Scalable Vision Learners},
  journal = {IEEE Conference on Computer Vision and Pattern Recognition (CVPR)},
  year = {2022},
  publisher = {IEEE},
  doi = {10.1109/CVPR52688.2022.01549},
  url = {https://arxiv.org/abs/2111.06377},
  abstract = {Masked Autoencoders mask large portions of image patches and train encoders to reconstruct masked pixels. MAE learns strong visual representations and scales well with model and data size.}
}

@article{chen2020mocov2,
  author = {Chen, Xinlei and Fan, Haoqi and Grischek, Geremy and He, Kaiming},
  title = {Improved Baselines with Momentum Contrast},
  journal = {European Conference on Computer Vision (ECCV)},
  year = {2020},
  publisher = {Springer},
  doi = {10.1007/978-3-030-58570-4_10},
  url = {https://arxiv.org/abs/2003.04291},
  abstract = {MoCo v2 improves momentum contrastive learning using stronger augmentations and a larger queue. It achieves strong representation learning and efficient few-shot transfer.}
}

@article{oquab2023dinov2,
  author = {Oquab, Maxime and Darcet, Timothée and Moutakanni, Theo and Vo, Huy and Szafraniec, Marc and Fernandez, Pierrick and Khalidov, Vasil and Haziza, Pierre and Massa, Francisco and El-Nouby, Alaaeldin and Assran, Mahmoud and Douze, Matthijs and Izquierdo, Francisco and Maji, Piotr and Alabdulmohsin, Ivan and Rückés, Louis and Howes, Rory and Chintala, Sylvain and Teterwak, Pierre and Szlam, Armand and Misra, Ishan and Mairal, Julien and Labatut, Patrick and Joulin, Armand and Bojanowski, Piotr},
  title = {DINOv2: Learning Robust Visual Features without Supervision},
  journal = {arXiv preprint},
  year = {2023},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2304.07193},
  url = {https://arxiv.org/abs/2304.07193},
  abstract = {DINOv2 learns image representations by self-distillation and masked-image modeling without labels. It produces features that transfer strongly to dense prediction and few-shot classification.}
}

@article{lee2013pseudolabeling,
  author = {Lee, Dong-Hyun},
  title = {Pseudo-Label: The Simple and Efficient Semi-Supervised Learning Method for Deep Neural Networks},
  journal = {Proceedings of the Workshop on Challenges in Representation Learning, ICML},
  year = {2013},
  publisher = {PMLR},
  url = {http://proceedings.mlr.press/v32/lee13.pdf},
  abstract = {Pseudo-labeling assigns high-confidence predictions to unlabeled examples and retrains the network. It is a simple semi-supervised technique useful when only a few labels are available.}
}

@article{tarvainen2017meanteacher,
  author = {Tarvainen, Antti and Valpola, Harri},
  title = {Mean Teachers Are Better Role Models: Weight-Averaged Consistency Targets Improve Semi-Supervised Deep Learning Results},
  journal = {Advances in Neural Information Processing Systems},
  year = {2017},
  volume = {30},
  publisher = {Curran Associates},
  url = {https://proceedings.neurips.cc/paper_files/paper/2017/file/6f4c38f1d45e9d261bc8e1a75f7e4424-Paper.pdf},
  abstract = {Mean Teacher uses an exponentially moving-average teacher network to stabilize pseudo-targets for unlabeled data in semi-supervised training.}
}

@article{snell2017prototypes,
  author = {Snell, Jake and Swersky, Kevin and Zemel, Richard},
  title = {Prototypical Networks for Few-shot Learning},
  journal = {Advances in Neural Information Processing Systems},
  year = {2017},
  volume = {30},
  publisher = {Curran Associates},
  url = {https://proceedings.neurips.cc/paper_files/paper/2017/file/a03f8360e7535c7d5c8b2e3f8d1d6d8c-Paper.pdf},
  abstract = {Prototypical networks learn an embedding space and classify by nearest-centroid distance to class prototypes. They are a simple few-shot learning approach.}
}

@article{finn2017maml,
  author = {Finn, Chelsea and Abbeel, Pieter and Levine, Sergey},
  title = {Model-Agnostic Meta-Learning for Fast Adaptation of Deep Networks},
  journal = {International Conference on Machine Learning},
  year = {2017},
  pages = {1126--1135},
  publisher = {PMLR},
  url = {http://proceedings.mlr.press/v70/finn17a/finn17a.pdf},
  abstract = {MAML trains models to adapt quickly to new tasks with few gradient steps. It is a meta-learning framework useful when only small task-specific datasets are available.}
}